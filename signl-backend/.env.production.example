# ─────────────────────────────────────────────────────────────────────────────
# SIGNL BACKEND — PRODUCTION ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to `.env` on the production host (NEVER commit the filled-in file).
# Every value marked <ROTATE> must be a FRESH secret — the ones shared over chat
# are considered compromised and must not be reused in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
# MUST be the exact production frontend origin (no trailing slash).
# Multiple origins allowed, comma-separated.
CORS_ORIGIN=https://signl.media

# ── Database (Neon) ──────────────────────────────────────────────────────────
# <ROTATE> Reset the Neon database password in the Neon console first, then
# paste the new pooled connection string here. Keep sslmode=require.
DATABASE_URL=postgresql://<new_user>:<new_password>@<host>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be 64-byte (128 hex char) random strings. The server refuses to boot in
# production if these are shorter than 64 chars.
JWT_ACCESS_SECRET=<paste_generated_64_byte_hex>
JWT_REFRESH_SECRET=<paste_generated_64_byte_hex>
# Optional hardening (defaults shown in jwt.ts): tune token lifetimes.
# JWT_ACCESS_TTL=7d
# JWT_REFRESH_TTL=30d
# JWT_ISSUER=signl
# JWT_AUDIENCE=signl-web

# ── Razorpay (LIVE) ──────────────────────────────────────────────────────────
# <ROTATE> Switch from test (rzp_test_*) to LIVE keys in the Razorpay dashboard
# → Settings → API Keys. The test keys shared over chat must NOT be used live.
RAZORPAY_KEY_ID=rzp_live_<your_live_key_id>
RAZORPAY_KEY_SECRET=<your_live_key_secret>
# <ROTATE> Webhook secret — Razorpay dashboard → Settings → Webhooks.
# NOTE: A server-side webhook handler is not yet implemented (see launch
# checklist). Until then, activation relies on the client /verify call only.
RAZORPAY_WEBHOOK_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# <ROTATE> Regenerate the client secret in Google Cloud Console → Credentials.
OAuth_Client_ID=<your_oauth_client_id>
OAuth_Client_Secret=<your_new_oauth_client_secret>

# ── Redis (optional — distributed rate limiting for multi-instance deploys) ──
# Leave blank for single-instance VPS; the app falls back to in-memory limits.
REDIS_URL=

# ── Search (optional) ────────────────────────────────────────────────────────
MEILI_HOST=
MEILI_MASTER_KEY=
