// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

//output   = "../generated/prisma"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  QUOTE
  CODE
  EMBED
  HEADING
  LIST
}

enum DepthType {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ArticleType {
  ARTICLE
  ANALYSIS
  BRIEF
  LEARN
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id String @id @default(cuid())

  email String @unique

  password String

  name String

  role UserRole @default(USER)

  avatar String?

  slug String? @unique

  title String?

  bio String?

  twitter String?

  linkedin String?

  emailVerified Boolean @default(false)

  googleId String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  bookmarks Bookmark[]

  readingHistory ReadingHistory[]

  updatedArticles Article[] @relation("ArticleUpdatedBy")

  authoredArticles Article[] @relation("ArticleAuthor")

  subscriptions Subscription[]
}

model NewsletterSubscriber {
  id String @id @default(cuid())

  email String @unique

  createdAt DateTime @default(now())
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  status    SubscriptionStatus @default(PENDING)
  plan      String
  startedAt DateTime           @default(now())
  expiresAt DateTime?

  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([razorpaySubscriptionId])
}

model Article {
  id String @id @default(cuid())

  title String

  slug String? @unique

  summary String

  contentText String?

  signal String?

  coverImage String?

  premium Boolean @default(false)

  verified Boolean @default(false)

  featured Boolean @default(false)

  articleType ArticleType

  status ArticleStatus @default(DRAFT)

  publishedAt DateTime?

  readTime Int @default(5)

  views Int @default(0)

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  canonicalUrl String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  authorId String

  author User @relation("ArticleAuthor", fields: [authorId], references: [id])

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  updatedById String?

  updatedBy User? @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])

  tags ArticleTag[]

  bookmarks Bookmark[]

  readingHistory ReadingHistory[]

  blocks ContentBlock[]

  depths ArticleDepth[]

  analysisSteps AnalysisStep[]

  placements HomepagePlacement[]

  analytics ArticleAnalytics?

  @@index([slug])
  @@index([status])
  @@index([articleType])
  @@index([createdAt])
  @@index([views])
  @@index([featured])
  @@index([verified])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([featured, status])
  @@index([premium, status])
}

model Category {
  id String @id @default(cuid())

  name String @unique

  slug String? @unique

  short String? @unique

  color String?

  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  articles Article[]
}

model Tag {
  id String @id @default(cuid())

  name String @unique

  slug String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  articles ArticleTag[]
}

model ArticleTag {
  articleId String

  tagId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model Bookmark {
  userId String

  articleId String

  user User @relation(fields: [userId], references: [id])

  article Article @relation(fields: [articleId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model ReadingHistory {
  id String @id @default(cuid())

  userId String

  articleId String

  progress Float

  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@index([lastReadAt])
}

model ContentBlock {
  id String @id @default(cuid())

  articleId String

  type BlockType

  content Json

  position Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([position])
}

model ArticleDepth {
  id String @id @default(cuid())

  articleId String

  depthType DepthType

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, depthType])
  @@index([articleId])
}

model AnalysisStep {
  id String @id @default(cuid())

  articleId String

  title String

  description String?

  stepNumber Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([stepNumber])
}

model HomepagePlacement {
  id String @id @default(cuid())

  articleId String

  section String

  priority Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([section])
  @@index([priority])
}

model ArticleAnalytics {
  id String @id @default(cuid())

  articleId String @unique

  totalViews Int @default(0)

  uniqueViews Int @default(0)

  bookmarks Int @default(0)

  impressions Int @default(0)

  clicks Int @default(0)

  shares Int @default(0)

  avgReadTime Float @default(0)

  bounceRate Float @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}
