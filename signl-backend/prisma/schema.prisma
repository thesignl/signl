// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

//output   = "../generated/prisma"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  QUOTE
  CODE
  EMBED
  HEADING
  LIST
}

enum DepthType {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ArticleType {
  ARTICLE
  ANALYSIS
  BRIEF
  LEARN
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum NewsletterStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  ARCHIVED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  COMPLAINED
}

model User {
  id String @id @default(cuid())

  email String @unique

  password String

  name String

  role UserRole @default(USER)

  avatar String?

  slug String? @unique

  title String?

  bio String?

  twitter String?

  linkedin String?

  emailVerified Boolean @default(false)

  googleId String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  bookmarks Bookmark[]

  readingHistory ReadingHistory[]

  updatedArticles Article[] @relation("ArticleUpdatedBy")

  authoredArticles Article[] @relation("ArticleAuthor")

  subscriptions Subscription[]

  payments Payment[]

  authoredNewsletters Newsletter[]         @relation("NewsletterAuthor")

  createdCampaigns    Campaign[]           @relation("CampaignCreatedBy")

  createdTemplates    NewsletterTemplate[] @relation("TemplateCreatedBy")
}

model NewsletterSubscriber {
  id String @id @default(cuid())

  email String @unique

  name String?

  status SubscriberStatus @default(ACTIVE)

  unsubscribeToken String  @unique @default(cuid())

  confirmToken String? @unique

  source String?

  confirmedAt DateTime?

  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  preferences EmailPreference[]

  recipients CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  status    SubscriptionStatus @default(PENDING)
  plan      String
  startedAt   DateTime           @default(now())
  expiresAt   DateTime?
  cancelledAt DateTime?

  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([razorpaySubscriptionId])
}

model Article {
  id String @id @default(cuid())

  title String

  slug String? @unique

  summary String

  contentText String?

  // Universal editor body (post-refactor). Both stored together:
  // - contentHtml: server-sanitized HTML for SSR rendering by the reader.
  // - contentJson: TipTap native JSON for round-trip editing without lossy
  //   HTML re-parse. Null on legacy articles that still render via blocks.
  contentHtml String?
  contentJson Json?

  signal String?

  coverImage String?

  premium Boolean @default(false)

  verified Boolean @default(false)

  featured Boolean @default(false)

  articleType ArticleType

  status ArticleStatus @default(DRAFT)

  publishedAt DateTime?

  readTime Int @default(5)

  views Int @default(0)

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  canonicalUrl String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  authorId String

  author User @relation("ArticleAuthor", fields: [authorId], references: [id])

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  updatedById String?

  updatedBy User? @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])

  tags ArticleTag[]

  bookmarks Bookmark[]

  readingHistory ReadingHistory[]

  blocks ContentBlock[]

  depths ArticleDepth[]

  analysisSteps AnalysisStep[]

  placements HomepagePlacement[]

  analytics ArticleAnalytics?

  @@index([slug])
  @@index([status])
  @@index([articleType])
  @@index([createdAt])
  @@index([views])
  @@index([featured])
  @@index([verified])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([featured, status])
  @@index([premium, status])
}

model Category {
  id String @id @default(cuid())

  name String @unique

  slug String? @unique

  short String? @unique

  color String?

  description String?

  displayOrder Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  articles Article[]
}

model Tag {
  id String @id @default(cuid())

  name String @unique

  slug String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  articles ArticleTag[]
}

model ArticleTag {
  articleId String

  tagId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model Bookmark {
  userId String

  articleId String

  user User @relation(fields: [userId], references: [id])

  article Article @relation(fields: [articleId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model ReadingHistory {
  id String @id @default(cuid())

  userId String

  articleId String

  progress Float

  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@index([lastReadAt])
}

model ContentBlock {
  id String @id @default(cuid())

  articleId String

  type BlockType

  content Json

  position Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([position])
}

model ArticleDepth {
  id String @id @default(cuid())

  articleId String

  depthType DepthType

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, depthType])
  @@index([articleId])
}

model AnalysisStep {
  id String @id @default(cuid())

  articleId String

  title String

  description String?

  stepNumber Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([stepNumber])
}

model HomepagePlacement {
  id String @id @default(cuid())

  articleId String

  section String

  priority Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([section])
  @@index([priority])
}

model ArticleAnalytics {
  id String @id @default(cuid())

  articleId String @unique

  totalViews Int @default(0)

  uniqueViews Int @default(0)

  bookmarks Int @default(0)

  impressions Int @default(0)

  clicks Int @default(0)

  shares Int @default(0)

  avgReadTime Float @default(0)

  bounceRate Float @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}

model NewsletterCategory {
  id String @id @default(cuid())

  name String @unique

  slug String @unique

  description String?

  active Boolean @default(true)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  newsletters Newsletter[]

  preferences EmailPreference[]

  @@index([active])
}

model EmailPreference {
  id String @id @default(cuid())

  subscriberId String

  categoryId String

  subscribed Boolean @default(true)

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  category NewsletterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, categoryId])
  @@index([categoryId])
}

model NewsletterTemplate {
  id String @id @default(cuid())

  name String @unique

  description String?

  contentHtml String

  contentJson Json?

  isDefault Boolean @default(false)

  createdById String?

  createdBy User? @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  newsletters Newsletter[]

  @@index([isDefault])
}

model Newsletter {
  id String @id @default(cuid())

  title String

  subject String

  preheader String?

  contentHtml String?

  contentJson Json?

  status NewsletterStatus @default(DRAFT)

  authorId String

  author User @relation("NewsletterAuthor", fields: [authorId], references: [id])

  categoryId String?

  category NewsletterCategory? @relation(fields: [categoryId], references: [id])

  templateId String?

  template NewsletterTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
}

model Campaign {
  id String @id @default(cuid())

  newsletterId String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  status CampaignStatus @default(DRAFT)

  subject String

  scheduledAt DateTime?

  startedAt DateTime?

  completedAt DateTime?

  totalRecipients Int @default(0)

  sentCount Int @default(0)

  deliveredCount Int @default(0)

  openCount Int @default(0)

  clickCount Int @default(0)

  bounceCount Int @default(0)

  failedCount Int @default(0)

  unsubscribeCount Int @default(0)

  createdById String?

  createdBy User? @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  deliveryLogs DeliveryLog[]

  @@index([status])
  @@index([scheduledAt])
  @@index([newsletterId])
}

model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String

  subscriberId String

  status DeliveryStatus @default(QUEUED)

  providerMessageId String?

  sentAt DateTime?

  openedAt DateTime?

  clickedAt DateTime?

  error String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, subscriberId])
  @@index([status])
  @@index([subscriberId])
  @@index([providerMessageId])
}

model DeliveryLog {
  id String @id @default(cuid())

  campaignId String?

  recipientId String?

  event DeliveryStatus

  providerMessageId String?

  detail String?

  meta Json?

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([event])
  @@index([providerMessageId])
  @@index([createdAt])
}
