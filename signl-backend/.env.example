# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: set to your frontend domain, e.g. https://app.signl.com
# Development default (used if this var is absent): http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
# PRODUCTION REQUIREMENT: must be a cryptographically random 64-byte hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will refuse to start if this variable is missing.
# The server will warn at startup if this value is shorter than 64 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Redis (optional, for distributed rate limiting in multi-instance deploys) ─
REDIS_URL=

# ── Search (optional) ─────────────────────────────────────────────────────────
MEILI_HOST=
MEILI_MASTER_KEY=

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# Store these in a secrets manager (AWS Secrets Manager, Vault, etc.) in production.
# Never commit real values to source control.
OAuth_Client_ID=
OAuth_Client_Secret=

# ── Razorpay (Phase F — payment gateway) ─────────────────────────────────────
# Obtain from dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_*) in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — configured in dashboard.razorpay.com → Settings → Webhooks
# Required for Phase F2 (webhook handling). Leave blank until then.
RAZORPAY_WEBHOOK_SECRET=

# ── Newsletter / Email delivery ───────────────────────────────────────────────
# Provider selection: "resend" (production) or "console" (default; logs only).
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend. Obtain from resend.com → API Keys.
RESEND_API_KEY=
# From identity for outbound mail, e.g. "Signl <brief@signl.media>"
EMAIL_FROM=
# Public API base URL used to build tokenized confirm/unsubscribe links in emails.
PUBLIC_API_URL=http://localhost:5000/api
# Require email confirmation before activating a subscriber (double opt-in).
NEWSLETTER_DOUBLE_OPT_IN=true
# Parallel sends per batch during a campaign dispatch.
NEWSLETTER_SEND_CONCURRENCY=10
# How often the in-process scheduler checks for due scheduled campaigns (ms).
NEWSLETTER_SCHEDULER_INTERVAL_MS=60000
# Resend webhook signing secret (whsec_…) — enables Svix signature verification.
RESEND_WEBHOOK_SECRET=
